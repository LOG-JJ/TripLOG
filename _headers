/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  X-Frame-Options: DENY
  Content-Security-Policy: script-src 'self' 'wasm-unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/sw.js
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/Travel*
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/repair*
  Cache-Control: no-cache

/site.webmanifest
  Cache-Control: no-cache

/apple-touch-icon.png
  Cache-Control: no-cache
